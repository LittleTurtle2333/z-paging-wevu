{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "z-paging-wevu-docs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
