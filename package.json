{
  "name": "z-paging-wevu",
  "version": "0.2.3",
  "description": "面向 weapp-vite + wevu 的 z-paging 兼容分页组件",
  "type": "module",
  "license": "MIT",
  "author": "littleturtle2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleTurtle2333/z-paging-wevu.git"
  },
  "homepage": "https://paging.weapp.dev/",
  "bugs": {
    "url": "https://github.com/LittleTurtle2333/z-paging-wevu/issues"
  },
  "keywords": [
    "z-paging",
    "weapp-vite",
    "wevu",
    "miniprogram",
    "pagination",
    "virtual-list"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./component": "./src/components/z-paging-wevu/index.vue",
    "./swiper": "./src/components/z-paging-swiper/index.vue",
    "./swiper-item": "./src/components/z-paging-swiper-item/index.vue",
    "./empty-view": "./src/components/z-paging-empty-view/index.vue",
    "./cell": "./src/components/z-paging-cell/index.vue",
    "./controller": {
      "types": "./src/components/z-paging-wevu/types.ts",
      "default": "./src/components/z-paging-wevu/types.ts"
    },
    "./props": {
      "types": "./src/components/z-paging-wevu/props.ts",
      "default": "./src/components/z-paging-wevu/props.ts"
    },
    "./resolver": {
      "types": "./resolver.d.ts",
      "default": "./resolver.mjs"
    }
  },
  "files": [
    "src",
    "resolver.mjs",
    "resolver.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "dev:docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:docs": "pnpm docs:build && node scripts/verify-docs.mjs",
    "build": "pnpm typecheck && pnpm docs:build",
    "demo:dev": "wv dev demo",
    "demo:build": "wv build demo"
  },
  "peerDependencies": {
    "wevu": ">=7.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "miniprogram-api-typings": "^5.2.3",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.12",
    "weapp-vite": "^7.5.0",
    "wevu": "^7.10.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.20.0"
}
