root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

# demo/src 是从 uni-z-paging 移植的演示代码，保持原有 Tab 缩进
[demo/src/**]
indent_style = tab
